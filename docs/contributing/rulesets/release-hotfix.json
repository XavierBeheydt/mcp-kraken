{
  "name": "release & hotfix protection",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/release/**",
        "refs/heads/hotfix/**"
      ],
      "exclude": []
    }
  },
  "rules": [
    {"type": "non_fast_forward"},
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          {"context": "test (3.12)"},
          {"context": "test (3.13)"}
        ]
      }
    }
  ],
  "bypass_actors": []
}
