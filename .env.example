# Which Kraken product to expose: `spot` (default) or `futures`.
# A single instance speaks one API at a time. Pick which credentials to
# fill in below accordingly — Spot and Futures keys are NOT interchangeable.
# MCP_KRAKEN_API=spot

# Kraken Spot API credentials (https://www.kraken.com/u/security/api)
# Used when MCP_KRAKEN_API=spot (the default).
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Kraken Futures API credentials
# (https://futures.kraken.com/trade/settings/api).
# Used when MCP_KRAKEN_API=futures. Issued separately from Spot keys.
# KRAKEN_FUTURES_API_KEY=
# KRAKEN_FUTURES_API_SECRET=

# When MCP_KRAKEN_API=futures, talk to demo-futures.kraken.com instead of
# production. Demo keys come from https://demo-futures.kraken.com/settings/api.
# MCP_KRAKEN_FUTURES_SANDBOX=false

# HTTP server
MCP_KRAKEN_HOST=0.0.0.0
MCP_KRAKEN_PORT=8765
MCP_KRAKEN_PATH=/mcp

# Auth token database
# SQLite file holding bearer-token metadata (hashed). The CLI commands
# `mcp-kraken token create|list|revoke` operate on this file.
MCP_KRAKEN_TOKEN_DB=./data/tokens.db

# Optional: TLS — serve HTTPS instead of HTTP when both paths are set.
# For local testing with Claude Desktop, generate a locally-trusted cert:
#   just cert-local
# (uses mkcert; the resulting CA is installed into the OS trust store).
# MCP_KRAKEN_SSL_KEYFILE=./certs/key.pem
# MCP_KRAKEN_SSL_CERTFILE=./certs/cert.pem

# Optional: HTTP timeout (seconds) for outbound Kraken calls
MCP_KRAKEN_HTTP_TIMEOUT=30

# Optional: log level (DEBUG, INFO, WARNING, ERROR)
MCP_KRAKEN_LOG_LEVEL=INFO

# Optional: disable bearer-token enforcement (DEV ONLY — never set in prod)
# MCP_KRAKEN_AUTH_DISABLED=false
